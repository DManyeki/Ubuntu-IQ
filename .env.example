# ==============================================
# DEVELOPMENT FLAGS
# ==============================================
# Set to 'true' to enable debug logs
DEBUG_MODE=false

# Set to 'true' to skip AI review (for testing)
SKIP_AI_REVIEW=false

# Set to 'true' to use mock data instead of real scraping
USE_MOCK_SCRAPER=false

# ==============================================
# SECURITY (Optional)
# ==============================================
# JWT secret for custom auth (if needed)
# JWT_SECRET=your-secure-random-string

# API rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# ==============================================
# NOTES
# ==============================================
# 1. Never commit this file to Git! Add to .gitignore
# 2. For production, add these to Vercel Environment Variables:
#    https://vercel.com/your-team/mindcare/settings/environment-variables
# 3. Service Role Key should only be used in server-side code (API routes)
# 4. Anon Key is safe to expose in client-side code
# 5. Blob token should be kept secret (server-side only)
